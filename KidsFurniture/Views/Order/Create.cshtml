@model KidsFurniture.Models.Order.OrderCreateVM

@{
    ViewData["Title"] = "Поръчка";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card create-product-card rounded-4 border-0">
                <div class="card-body p-5">
                    <h1 class="fw-bold text-center mb-4">Завърши поръчката</h1>
                    <p class="text-center text-secondary mb-4">
                        Потвърдете количеството и финалната цена.
                    </p>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" asp-for="Picture" />

                        <div class="row align-items-center">
                            <!-- PRODUCT PREVIEW -->
                            <div class="col-md-5 text-center mb-4 mb-md-0">
                                <img src="@Model.Picture"
                                     alt="@Model.ProductName"
                                     class="img-fluid rounded-4 shadow-sm order-preview-img" />
                            </div>

                            <!-- ORDER INFO -->
                            <div class="col-md-7">
                                <div class="mb-3">
                                    <label asp-for="ProductName" class="form-label fw-semibold">Продукт</label>
                                    <input asp-for="ProductName" class="form-control rounded-3" readonly />
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Price" class="form-label fw-semibold">Цена</label>
                                        <input asp-for="Price" class="form-control rounded-3" readonly />
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Discount" class="form-label fw-semibold">Отстъпка %</label>
                                        <input asp-for="Discount" class="form-control rounded-3" readonly />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label fw-semibold">
                                        Количество (налични: @Model.QuantityInStock)
                                    </label>
                                    <input asp-for="Quantity"
                                           class="form-control rounded-3"
                                           id="Quantity"
                                           min="1"
                                           max="@Model.QuantityInStock"
                                           oninput="calcSum()" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="TotalPrice" class="form-label fw-semibold">Крайна цена</label>
                                    <input asp-for="TotalPrice"
                                           class="form-control rounded-3"
                                           readonly />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-product-order px-4">
                                 Потвърди поръчката
                            </button>

                            <a asp-controller="Product"
                               asp-action="Index"
                               class="btn btn-product-details px-4">
                                Назад към продуктите
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function calcSum() {
        let q = document.getElementsByName('Quantity')[0].value || 0;
        let p = document.getElementsByName('Price')[0].value || 0;
        let d = document.getElementsByName('Discount')[0].value || 0;

        let sum = Number(q) * (Number(p) - Number(p) * Number(d) / 100);
        document.getElementsByName('TotalPrice')[0].value = sum.toFixed(2);
    }

    window.onload = calcSum;
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}