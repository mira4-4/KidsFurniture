@model IEnumerable<KidsFurniture.Models.Order.OrderIndexVM>

@{
    ViewData["Title"] = "Моите поръчки";
}

<div class="container py-5">
    <h1 class="fw-bold mb-5">Моите поръчки</h1>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-6">
                <div class="card premium-card order-history-card h-100 rounded-4 border-0">
                    <div class="row g-0 h-100">
                        <div class="col-md-4">
                            <img src="@item.Picture"
                                 class="img-fluid h-100 rounded-start-4 order-history-img"
                                 alt="@item.Product" />
                        </div>

                        <div class="col-md-8">
                            <div class="card-body d-flex flex-column h-100">
                                <h4 class="fw-bold">@item.Product</h4>
                                <p class="text-secondary mb-2">@item.Description</p>

                                <p class="mb-1">
                                    <strong>Дата:</strong> @item.OrderDate
                                </p>

                                <p class="mb-1">
                                    <strong>Количество:</strong> @item.Quantity
                                </p>

                                <p class="mb-1">
                                    <strong>Цена:</strong> @item.Price лв.
                                </p>

                                @if (item.Discount > 0)
                                {
                                    <p class="mb-1 text-danger">
                                        <strong>Отстъпка:</strong> @item.Discount%
                                    </p>
                                }

                                <div class="mt-auto pt-3">
                                    <span class="badge bg-danger fs-6 p-3 rounded-3">
                                        Общо: @item.TotalPrice лв.
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>