@model IEnumerable<KidsFurniture.Models.Product.ProductIndexVM>

@{
    ViewData["Title"] = "Любими";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="fw-bold mb-2">Любими продукти</h1>
        <span class="text-secondary d-block">
            Вашите запазени мебели ❤️
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h3 class="fw-bold">Нямате любими продукти</h3>
            <p class="text-secondary">Добавете мебели в любими от страницата с продукти.</p>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-product-order px-4 mt-3">
                Разгледай продукти
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 rounded-4 premium-card border-0 product-card">
                        <img src="@item.Picture"
                             class="card-img-top rounded-top-4"
                             style="height:260px; object-fit:cover;"
                             alt="@item.ProductName" />

                        <div class="card-body">
                            <p class="text-secondary mb-1">@item.CategoryName</p>
                            <h4 class="fw-bold">@item.ProductName</h4>
                            <p class="text-muted">@item.BrandName</p>

                            <p class="text-secondary">@item.Description</p>

                            <div class="d-flex justify-content-between mt-3">
                                <span><strong>Наличност:</strong> @item.Quantity</span>
                                <span class="fw-bold text-danger">@item.Price лв.</span>
                            </div>

                            @if (item.Discount > 0)
                            {
                                <div class="mt-2">
                                    <span class="badge bg-danger">
                                        -@item.Discount%
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="card-footer bg-white border-0 pt-0 pb-4">
                            <div class="product-actions-vertical">

                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-product-details w-100">
                                    Детайли
                                </a>

                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a asp-controller="Order"
                                       asp-action="Create"
                                       asp-route-id="@item.Id"
                                       class="btn btn-product-order w-100">
                                        Поръчай
                                    </a>
                                }

                                <form asp-controller="Favorites"
                                      asp-action="Remove"
                                      method="post"
                                      class="w-100">
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button type="submit"
                                            class="btn btn-product-delete w-100">
                                        Махни от любими
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>