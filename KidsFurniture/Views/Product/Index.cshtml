@model IEnumerable<KidsFurniture.Models.Product.ProductIndexVM>

@{
    ViewData["Title"] = "Продукти";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Нашите продукти</h1>

        @if (User.Identity.IsAuthenticated && User.IsInRole("Administrator"))
        {
            <a asp-action="Create" class="btn btn-custom-primary">
                + Създай нов
            </a>
        }
    </div>

    <!-- FILTER -->
    <form asp-controller="Product" asp-action="Index" method="get" class="row g-3 mb-5">
        <div class="col-md-4">
            <input type="text" name="SearchStringBrandName" class="form-control"
                   placeholder="Търси по производител..." />
        </div>
        <div class="col-md-4">
            <input type="text" name="SearchStringCategoryName" class="form-control"
                   placeholder="Търси по категория..." />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-custom-primary w-100">Филтър</button>
        </div>
    </form>

    <!-- PRODUCT GRID -->
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 rounded-4 product-card premium-card">
                    <img src="@item.Picture"
                         class="card-img-top rounded-top-4"
                         style="height:260px; object-fit:cover;"
                         alt="@item.ProductName" />

                    <div class="card-body">
                        <h4 class="fw-bold">@item.ProductName</h4>
                        <p class="text-muted mb-1">@item.BrandName</p>
                        <p class="mb-2"><strong>Категория:</strong> @item.CategoryName</p>
                        <p class="text-secondary">@item.Description</p>

                        <div class="d-flex justify-content-between mt-3">
                            <span><strong>Количество:</strong> @item.Quantity</span>
                            <span class="fw-bold text-danger">@item.Price лв.</span>
                        </div>

                        @if (item.Discount > 0)
                        {
                            <div class="mt-2">
                                <span class="badge bg-danger">-@item.Discount%</span>
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-white border-0 pt-0 pb-4">
                        <div class="product-actions-vertical">

                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-product-details w-100">
                                Детайли
                            </a>

                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Order"
                                   asp-action="Create"
                                   asp-route-id="@item.Id"
                                   class="btn btn-product-order w-100">
                                    Поръчай
                                </a>

                                <form asp-controller="Favorites" asp-action="Add" method="post" class="w-100">
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button type="submit" class="btn btn-product-favorite w-100">
                                        ❤ Добави в любими
                                    </button>
                                </form>
                            }

                            @if (User.Identity.IsAuthenticated && User.IsInRole("Administrator"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-product-edit w-100">
                                    Редактирай
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-product-delete w-100">
                                    Изтрий
                                </a>
                            }

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>