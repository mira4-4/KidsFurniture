@model KidsFurniture.Models.Product.ProductDeleteVM

@{
    ViewData["Title"] = "Изтрий продукт";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card delete-product-card rounded-4 border-0">
                <div class="card-body p-5">
                    <h1 class="fw-bold text-center text-danger mb-3">Изтрий продукт</h1>
                    <p class="text-center text-secondary mb-4">
                        Сигурни ли сте, че искате да изтриете този продукт?
                    </p>

                    <!-- PRODUCT PREVIEW -->
                    <div class="row align-items-center mb-4">
                        <div class="col-md-5 text-center">
                            <img src="@Model.Picture"
                                 alt="@Model.ProductName"
                                 class="img-fluid rounded-4 shadow-sm delete-preview-img" />
                        </div>

                        <div class="col-md-7">
                            <h3 class="fw-bold">@Model.ProductName</h3>
                            <p><strong>Производител:</strong> @Model.BrandName</p>
                            <p><strong>Категория:</strong> @Model.CategoryName</p>
                            <p><strong>Описание:</strong> @Model.Description</p>
                            <p><strong>Количество:</strong> @Model.Quantity</p>
                            <p><strong>Цена:</strong> @Model.Price лв.</p>
                            <p><strong>Отстъпка:</strong> @Model.Discount%</p>
                        </div>
                    </div>

                    <div class="alert alert-danger rounded-3">
                         Това действие е необратимо и продуктът ще бъде премахнат от каталога.
                    </div>

                    <form asp-action="Delete" class="d-flex gap-3 mt-4">
                        <input type="hidden" asp-for="Id" />

                        <button type="submit" class="btn btn-product-delete px-4">
                             Изтрий
                        </button>

                        <a asp-action="Index" class="btn btn-product-details px-4">
                            Назад
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}